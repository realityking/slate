{
  "private": true,
  "size-limit": [
    {
      "path": "build/javascripts/all.js",
      "limit": "48kB"
    },
    {
      "path": "build/javascripts/all_nosearch.js",
      "limit": "38kB"
    },
    {
      "path": "build/stylesheets/screen.css",
      "limit": "4kB"
    },
    {
      "path": "build/stylesheets/print.css",
      "limit": "2kB"
    },
    {
      "path": "build/images/navbar.png",
      "limit": "1kB"
    },
    {
      "path": "build/fonts/slate.woff2",
      "limit": "1kB"
    },
    {
      "path": "build/index.html",
      "limit": "5kB"
    }
  ],
  "scripts": {
    "build": "bundle exec middleman build",
    "build:size": "SLATE_NO_HASH=1 bundle exec middleman build",
    "size": "size-limit"
  },
  "devDependencies": {
    "@size-limit/file": "^8.2.6",
    "size-limit": "^8.2.6"
  }
}
